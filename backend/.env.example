DATABASE_URL=

# LLM Configuration for band generation
# Set these to enable AI-generated band recommendations when database is insufficient
# LLM API Type: 'openai' (default) or 'anthropic'
# - 'openai': OpenAI-compatible API format (OpenAI, LM Studio, Ollama, etc.)
# - 'anthropic': Anthropic Claude API format
LLM_API_TYPE=openai
LLM_ENDPOINT=http://your-llm-server:port
LLM_AUTH_TOKEN=your-api-key-here
LLM_MODEL=your-model-name

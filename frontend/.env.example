# API Configuration
# Set to 'true' to use API mode (requires backend server running)
# Set to 'false' or omit to use static mode (default, no backend required)
VITE_API_MODE=false

# API URL (only used when VITE_API_MODE=true)
VITE_API_URL=http://localhost:3001

# Minimum number of bands required per genre to be displayed
# Genres with fewer bands will be hidden from the selection
VITE_MIN_BANDS_PER_GENRE=30

# LLM Configuration
# Set to 'true' to enable LLM-powered recommendations (requires backend with LLM support)
VITE_ENABLE_LLM=false

# LLM Endpoint (optional, user can also input this in the UI)
# VITE_LLM_ENDPOINT=http://your-llm-server:port/v1

# LLM API Key (optional, user can also input this in the UI)
# VITE_LLM_API_KEY=your-api-key-here

# LLM Model name (optional)
# VITE_LLM_MODEL=your-model-name
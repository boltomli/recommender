# API URL (used when VITE_STATIC_MODE is false)
VITE_API_URL=http://localhost:3001

# Static Mode Configuration
# Set to 'true' to run without a backend - all data comes from static JSON files
# Perfect for deployment on Netlify, Vercel, GitHub Pages, etc.
VITE_STATIC_MODE=false

# URL to the static data JSON file (used when VITE_STATIC_MODE is true)
# Default: /data/bands.json (relative to the site root)
VITE_STATIC_DATA_URL=/data/bands.json

# Minimum number of bands required per genre to be displayed
# Genres with fewer bands will be hidden from the selection
VITE_MIN_BANDS_PER_GENRE=30

# LLM Proxy Configuration (for static mode)
# Set to 'true' to force using proxy for LLM calls (recommended)
# Set to 'false' to allow direct LLM API calls (requires CORS support from LLM provider)
VITE_USE_LLM_PROXY=true

# Use Netlify Function proxy in development (requires 'netlify dev' running)
# Set to 'true' to use Netlify Function instead of backend proxy
# Useful when testing static deployment locally
VITE_USE_NETLIFY_PROXY=false
